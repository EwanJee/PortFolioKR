---
import '@fontsource/poppins/latin-400.css';
import '@fontsource/poppins/latin-500.css';
import '@fontsource/poppins/latin-600.css';
import '@fontsource/poppins/latin-700.css';
import 'pretendard/dist/web/variable/pretendardvariable-dynamic-subset.css';
import '../styles/tokens.css';
import '../styles/global.css';
import BaseHead from '../components/BaseHead.astro';
import SiteHeader from '../components/SiteHeader.astro';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  variant?: 'hero' | 'bar';
  // 본문이 나타나는 움직임. 사례 페이지는 자리 이동 없이 투명도만 바꾼다(윗부분 이미지를 제자리에서 그려야 GIF가 가장 큰 요소로 바뀌지 않는다).
  motion?: 'rise' | 'fade';
  clientRouter?: boolean;
}

const { title, description, ogImage = '/open-graph/index.png', variant = 'bar', motion = 'rise', clientRouter = true } = Astro.props;
---
<html lang="ko">
  <head>
    <BaseHead title={title} description={description} ogImage={ogImage} clientRouter={clientRouter} />
  </head>
  <body>
    <a class="skip-link" href="#main">본문으로 건너뛰기</a>
    <SiteHeader variant={variant}><slot name="typed" slot="typed" /></SiteHeader>
    <main id="main" class={variant === 'hero' ? 'main main--hero' : `main ${motion}`}><slot /></main>
  </body>
</html>
