---
import CountUp from '../islands/CountUp';
import type { Segment } from '../data/career';

interface Props {
  parts: Segment[];
}

// 글자와 움직이는 숫자(CountUp)가 섞인 경력 문장을 그린다.
const { parts } = Astro.props;
---
{parts.map((p) => (typeof p === 'string' ? p : <CountUp client:visible to={p.count} />))}
